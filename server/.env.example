NODE_ENV=development
PORT=3000
APP_ORIGIN=http://localhost:5173
DATABASE_URL=postgresql://quizflow:quizflow@localhost:5432/quizflow
# Prefer your provider's verified TLS URL; leave false for local PostgreSQL.
DATABASE_SSL=false
# Replace with: openssl rand -hex 32
JWT_SECRET=replace-with-at-least-32-random-characters
AI_PROVIDER=demo
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
# Set 1 only behind one trusted hosting reverse proxy.
TRUST_PROXY=0
